							"raw": "{\n    \"nome\": \"Musculação\",\n    \"descricao\": \"Treino de força com pesos livres e máquinas.\",\n    \"icon\": \"💪\",\n    \"ordem_exibicao\": 1,\n    \"valor_mensal\": 129.9,\n    \"duracao_meses\": 12,\n    \"ativo\": true\n}",
