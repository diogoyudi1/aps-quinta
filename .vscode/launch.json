{
    "version": "0.2.0",
    "configurations": [

        {
            "type": "node",
            "request": "launch",
            "name": "Debug API",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeArgs": [
                "--env-file=.env",
                "--import=tsx/esm"
            ],
            "program": "${workspaceFolder}/src/server.ts",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
